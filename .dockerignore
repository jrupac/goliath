# The image must be reproducible from source alone, so host build artifacts
# must never enter the build context. Modules are downloaded inside the build;
# a vendor directory on the host is not used, and Go would pick one up
# automatically and fail the build once it drifted from go.mod.
vendor
**/vendor
node_modules
**/node_modules

# Build outputs.
dist
out
build
**/build

# Host-only state: runtime config is bind-mounted by compose, and dev database
# snapshots are large and irrelevant to the image.
config.ini
tools/dev-db/snapshots

# Not read during the build; BUILD_HASH/BUILD_TIMESTAMP come in as build args.
.git
